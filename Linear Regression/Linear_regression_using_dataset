import pandas as pd
import numpy as np

# =========================
# Load dataset
# =========================
data = pd.read_csv("house_price_large.csv")

X = data[["size_sqm", "bedrooms", "age_years"]].values
y = data["price"].values.reshape(-1, 1)

# =========================
# Train-test split (80/20)
# =========================
def train_test_split(X, y, test_size=0.2):
    split = int(len(X) * (1 - test_size))
    return X[:split], X[split:], y[:split], y[split:]

X_train, X_test, y_train, y_test = train_test_split(X, y)

# =========================
# Normalisation
# =========================
mean = X_train.mean(axis=0)
std = X_train.std(axis=0)

X_train = (X_train - mean) / std
X_test = (X_test - mean) / std

# Add bias column
X_train = np.c_[np.ones((X_train.shape[0], 1)), X_train]
X_test = np.c_[np.ones((X_test.shape[0], 1)), X_test]

# =========================
# Linear Regression
# =========================
class LinearRegression:
    def __init__(self, lr=0.01, epochs=3000):
        self.lr = lr
        self.epochs = epochs

    def fit(self, X, y):
        self.theta = np.zeros((X.shape[1], 1))

        for _ in range(self.epochs):
            y_pred = X @ self.theta
            error = y_pred - y
            gradients = (2 / len(X)) * X.T @ error
            self.theta -= self.lr * gradients

    def predict(self, X):
        return X @ self.theta

# =========================
# Train
# =========================
model = LinearRegression(lr=0.01, epochs=4000)
model.fit(X_train, y_train)

# =========================
# Test
# =========================
pred = model.predict(X_test)

rmse = np.sqrt(np.mean((y_test - pred) ** 2))
print("Test RMSE:", int(rmse))

# =========================
# Sample predictions
# =========================
for i in range(5):
    print(f"Actual: {int(y_test[i][0])}  Predicted: {int(pred[i][0])}")
